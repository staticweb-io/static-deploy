#!/usr/bin/env bash
set -euo pipefail

FLAKE_REF="github:staticweb-io/wordpress-flake"
SYSTEM=$(nix eval --impure --expr builtins.currentSystem --raw)

readme_headers=$(nix build --print-out-paths '.#readmeHeaders')
requires=$(jq -r '.["Requires at least"]' "$readme_headers")
echo "Declared minimum WP version (Requires at least): $requires"
requires_php=$(jq -r '.["Requires PHP"]' "$readme_headers")
echo "Declared minimum PHP version (Requires PHP): $requires_php"
version=$(jq -er '.["Stable tag"]' "$readme_headers")
echo "Plugin version (Stable tag): $version"
name=$(sed -n 's/^=== \(.*\) ===$/\1/p' readme.txt)

echo "Getting wordpress_* packages from $FLAKE_REF for system $SYSTEM..."

# Sort wordpress packages by version descending
wordpress_packages=$(nix eval --json --impure \
  --expr "builtins.attrNames (builtins.getFlake \"$FLAKE_REF\").packages.\"$SYSTEM\"" \
  | jq -r '.[]' | grep '^wordpress_' \
  | sort -t_ -k2,2nr -k3,3nr -k4,4nr\
  | awk -F_ '!seen[$2"_"$3]++')

if [[ -z "$wordpress_packages" ]]; then
  echo "No wordpress_* packages found."
  exit 1
fi
tested_pkg=""
for pkg in $wordpress_packages; do
  pkg_version="${pkg#wordpress_}"
  pkg_version="${pkg_version//_/.}"
  pkg_version="${pkg_version%.*}"

  echo -e "\n➡️  Running check for WORDPRESS_PACKAGE=$pkg"
  if WORDPRESS_PACKAGE="$pkg" nix flake check --impure ./dev; then
    [[ -z "$tested_pkg" ]] && tested_pkg="$pkg"
  else
    echo "❌ Check failed for $pkg"
    break
  fi

  # Stop once we've tested down to the declared minimum
  if [[ "$pkg_version" == "$requires" ]]; then
    break
  fi
done

if [[ -n "$tested_pkg" ]]; then
  tested="${tested_pkg#wordpress_}"
  tested="${tested//_/.}"
  tested="${tested%.*}"

  # Ask the locked flake because that's the prerelease that nix flake check tests
  locked_rev=$(nix flake metadata ./dev --json 2>/dev/null | jq -r '.locks.nodes["wordpress-flake"].locked.rev')
  prerelease_version=$(nix eval "$FLAKE_REF/$locked_rev#prerelease.version" --raw 2>/dev/null || echo "")

  # Compare major.minor because that's all that Tested up to records
  if [[ "$prerelease_version" =~ ^[0-9]+\.[0-9]+ ]]; then
    prerelease_minor="${BASH_REMATCH[0]}"
    newest_minor=$(printf '%s\n' "$tested" "$prerelease_minor" | sort -V | tail -n 1)
    if [[ "$prerelease_minor" != "$tested" && "$prerelease_minor" == "$newest_minor" ]]; then
      echo -e "\n➡️  Running check for WordPress prerelease $prerelease_version"
      if WORDPRESS_PACKAGE=prerelease nix flake check --impure ./dev; then
        tested="$prerelease_minor"
      else
        echo "❌ Check failed for WordPress prerelease $prerelease_version"
      fi
    fi
  fi

  echo -e "\n✅ Tested up to: $tested"

  last_updated=$(git log -1 --format="%ci")

  # Update readme.txt Tested up to
  sed -i "s/^Tested up to: .*/Tested up to: $tested/" readme.txt

  # Generate update.json. Run this after the GitHub release exists, so that download_url resolves.
  jq -n \
    --arg download_url "https://github.com/staticweb-io/static-deploy/releases/download/v$version/plugin.zip" \
    --arg last_updated "$last_updated" \
    --arg name "$name" \
    --arg requires "$requires" \
    --arg requires_php "$requires_php" \
    --arg tested "$tested" \
    --arg version "$version" \
    '$ARGS.named' > update.json
else
  echo -e "\n❌ No successful checks."
fi
